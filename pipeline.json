  "_meta": {
    "version": "0.2.1",
    "updated": "2026-09-23",
    "schema_version": 2,
    "scope": "prompt_contract 是輸出資料契約；snapshot 是磁碟工作流快照，非模型或 GPU 實跑驗證。"
  },
  "prompt_contract": {
    "compiler_outputs": [
      "positive"
    ],
    "positive_prefix": "masterpiece, best quality, score_7, {rating},",
    "fixed_style_tags": {
      "tags": "high contrast",
      "placement": "角色／系列之後、外觀與一般描述之前（官方順序的一般標籤段開頭）",
      "note": "原 prefix 的 high contrast 為使用者既有風格決定，移出 prefix 以符合官方 tag 順序，仍為固定輸出。"
    },
    "rating_slot": {
      "default": "safe",
      "allowed": [
        "safe",
        "sensitive",
        "explicit"
      ]
    },
    "rating_by_mode": {
      "safe": {
        "rating": "safe",
        "required_tags": []
      },
      "sensitive": {
        "rating": "sensitive",
        "required_tags": []
      },
      "adult": {
        "rating": "explicit",
        "required_tags": [
          "adult"
        ]
      }
    },
    "content_policy_source": "directing.md D03",
    "tag_order": {
      "sequence": "prefix（品質／rating）→ 人數（1girl、1boy 等）→ 角色 → 系列 → 固定風格詞 → 其餘描述",
      "source": "Anima 官方模型卡 Tag order：[quality/meta/year/safety] [1girl/1boy/1other] [character] [series] [artist] [general]"
    },
    "serialization": {
      "separator": "每個逗號後一個半形空格；整段單行，不換行",
      "literal_parentheses": "tag 內的字面括號輸出為 \\( 與 \\)，例：kafka \\(honkai: star rail\\)。characters.json 仍存未跳脫原文。",
      "literal_parentheses_reason": "ComfyUI 原生 CLIPTextEncode 的 token_weights() 會把未跳脫的 (...) 視為 1.1 權重並移除括號；只有 \\( \\) 保留字面括號（comfy/sd1_clip.py）。",
      "weighting": "預設不輸出權重語法；僅在使用者明示要求權重時照寫其數值。",
      "weighting_reason": "ComfyUI anima.py 將 Qwen 分支權重固定為 1.0，權重只作用於 T5 id 分支；官方指出權重需高於 SDXL 慣用值（例 (chibi:2)）。本 pipeline 尚未測出有效區間。"
    },
    "negative": {
      "base": "worst quality, low quality, score_1, score_2, score_3, artist name, blurry, jpeg artifacts, chromatic aberration",
      "hands_feet_guard": "bad hands, extra fingers, missing fingers, fused fingers, bad feet, extra toes, missing toes, fused toes",
      "target": "worst quality, low quality, score_1, score_2, score_3, artist name, blurry, jpeg artifacts, chromatic aberration, bad hands, extra fingers, missing fingers, fused fingers, bad feet, extra toes, missing toes, fused toes",
      "format": "單行、逗號加空格，不換行",
      "source": "base 依官方建議負向；hands_feet_guard 為本專案沿用。使用者決定不加入安全標籤（nsfw, explicit）。"
    },
    "prefix_policy": "prefix 依官方 Anima-Base 建議前綴（masterpiece, best quality, score_7, safe）改寫，rating 保留為槽位。移除 very aesthetic、ultra detailed：兩者不在官方品質／meta 標籤體系內。score_7 是否適用目前的微調模型待確認（見 V-004）；若其基底為 Anima-Aesthetic，官方建議正負向皆不用 score_* 標籤。"
  },
